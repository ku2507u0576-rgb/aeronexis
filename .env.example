# ============================================
# Real-Time Airfare Price Index (APIx)
# Environment Configuration
# ============================================

# Database (SQLite for demo, PostgreSQL for production)
DATABASE_URL=sqlite:///./airfare_index.db
# DATABASE_URL=postgresql://user:password@localhost:5432/airfare_index

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY_SECRET=apix-demo-key-2026
API_RATE_LIMIT_PER_DAY=1000
API_RATE_LIMIT_PER_MINUTE=10

# Scraper Configuration (for production use)
PROXY_LIST=http://proxy1:8080,http://proxy2:8080
CAPTCHA_API_KEY=your_2captcha_key
SCRAPE_DELAY_SECONDS=10
MAX_RETRIES=3

# Index Configuration
BASE_YEAR=2023
BASE_VALUE=100.0

# Frontend
REACT_APP_API_URL=http://localhost:8000
