our ideal soundtrack today!","meta":{"title":"Download Free Worship Stock Music for Videos and Projects | Coverr","description":"Explore our collection of royalty-free Worship music. Perfect for videos and projects, find and download high-quality stock music tracks on Coverr."},"redirect":null,"sstkQuery":null,"allSlugs":["adoracion","aanbidding","le-culte","anbetung","adoracao","worship","il-culto"],"objectID":"LmPJNjn17Oue","originalName":"Worship"}],"translations-en":{"id":"vOaDiG8SQLBg","createdAt":"2026-04-07T10:21:14.083Z","updatedAt":"2026-09-03T15:14:32.544Z","lang":"en","data":{"ads":{"remove_ads":"Remove ads","promoted_ad":"Promoted ad"},"api":{"mcp":{"cta":"Explore MCP Integration","title":"Agent-Ready via Model Context Protocol (MCP)","example":"An AI agent can search footage, generate supporting media, and return structured results in a single automated workflow.","discovery":{"title":"Content Discovery","description":"Programmatic content discovery across video, audio, and image libraries."},"execution":{"title":"Tool Execution","description":"Structured tool execution inside agent frameworks like LangChain and AutoGPT."},"retrieval":{"title":"Search & Retrieval","description":"Autonomous search and retrieval with structured, context-aware results."},"workflows":{"title":"Media Workflows","description":"Multi-step media workflows that chain search, generation, and delivery."},"description":"The Coverr API integrates with AI agents and automated systems using MCP compatibility."},"faqs":[{"answer":"Yes. You get 1,000 free API calls per month on the Staging tier. This is great for evaluation and development. Upgrade to Production for higher limits.","question":"Is the API free?"},{"answer":"Staging apps get 1,000 calls per month. Production apps get 500 calls per minute. Enterprise plans with custom limits are available on request.","question":"What are the rate limits?"},{"answer":"Absolutely. All content accessed through the API is commercially licensed. Videos require Coverr attribution — see our documentation for details.","question":"Can I use the API for commercial purposes?"},{"answer":"Once your Staging app is ready, request Production verification from your dashboard. After approval, you’ll get 500 requests per minute with no monthly cap.","question":"How do I scale to production?"},{"answer":"Yes. The Coverr API supports the Model Context Protocol (MCP), enabling AI agents to discover, search, and retrieve content autonomously within multi-step workflows.","question":"Is the API compatible with MCP / AI agents?"},{"answer":"Yes. Enterprise solutions with custom rate limits, SLAs, and dedicated support are available. \u003Ca href=\"mailto:team@coverr.co\" target=\"_blank\">Contact our team\u003C/a> to discuss your requirements.","question":"Do you offer enterprise support?"}],"meta":{"title":"Production-Ready Content API That Scales | Coverr","description":"Access curated stock video and AI-generated media through a single, high-performance API. Built for modern products. Agent-ready via MCP."},"scale":{"title":"Built to Handle Real Traffic","feature_1":{"title":"Simple Integration","description":"Deploy in minutes with straightforward REST endpoints."},"feature_2":{"title":"Reliability","description":"Serving hundreds of thousands of daily calls across Coverr products and partners."},"feature_3":{"title":"Scalability","description":"From early-stage startups to high-throughput SaaS platforms."}},"title":"Production-Ready Content API That Scales","powered":{"title":"Powered by Coverr","description":"See the Video API in action"},"pricing":{"cta":"View Pricing Plans","title":"Scale Beyond the Free Tier","limits":{"title":"Higher Limits","description":"Increase monthly API call limits for production workloads."},"premium":{"title":"Premium Access","description":"Access premium-only content and advanced API features."},"support":{"title":"Priority Support","description":"Dedicated support for scaling teams and enterprise needs."},"throughput":{"title":"Production Throughput","description":"Unlock higher request rates to handle real user traffic."},"coming_soon":"Generative Endpoints — Coming Soon","description":"Start free with 1,000 calls/month. Upgrade to unlock higher production quotas, priority access, and advanced capabilities.","coming_soon_description":"AI video, image, music, and SFX generation endpoints will be available under paid plans with usage-based quotas."},"signals":{"rest":"REST-based, simple integration","stock_ai":"Stock + AI in one API","free_calls":"1,000 free calls/month"},"examples":{"get":"Get a video","list":"Search videos","title":"Make Your First API Call in Minutes","search":"List popular videos"},"subtitle":"Access curated stock video and AI-generated media through a single, high-performance API. Built for modern products. Agent-ready via MCP.","final_cta":{"title":"Ready to Integrate Scalable Content Into Your Product?","contact_sales":"Contact Sales"},"use_cases":{"cases":[{"cta":"Start Building","title":"SaaS Platforms & Creator Tools","problem":"Content platforms need reliable, searchable media libraries without managing storage.","solution":"Embed the Coverr API to offer video, image, and audio search directly inside your product."},{"cta":"Start Building","title":"Marketing Automation & Ad-Tech","problem":"Marketing teams waste hours sourcing and licensing content for campaigns.","solution":"Automate content selection with semantic search and programmatic access to licensed media."},{"cta":"Start Building","title":"Enterprise Workflow Systems","problem":"Internal tools lack dynamic media for reports, dashboards, and communications.","solution":"Integrate stock and AI-generated content into enterprise workflows via REST API."},{"cta":"Start Building","title":"AI Application Builders","problem":"AI products need structured media access for multi-modal generation pipelines.","solution":"Use MCP-compatible endpoints for autonomous content discovery and retrieval."}],"title":"Built for Every Use Case"},"how_to_use":{"cta":"See Pricing","title":"From API Key to Production","step_1":{"title":"Get Your API Key","description":"Create an account and access your key instantly."},"step_2":{"title":"Make a Request","description":"Call any endpoint using REST."},"step_3":{"title":"Scale to Production","description":"Move from 1,000 monthly calls to unlimited calls and downloads (500 reqs/minute)."}},"get_api_key":"Get API Key","get_started":"Get Started","brands_title":"Trusted by Leading Platforms","capabilities":{"title":"One API. Multiple Content Capabilities","ai_music":{"items":["Generate original music tracks via API","Create sound effects for apps and video workflows","Automate audio creation inside production pipelines"],"title":"AI-Generated Content (Music & SFX)"},"ai_video":{"items":["Generate videos programmatically via API","Create AI images for dynamic visual experiences","Embed generation directly inside SaaS products"],"title":"AI-Generated Content (Video & Images)"},"ai_search":{"items":["Natural language search across video and audio","Context-aware results (scene, mood, intent)","Optimized for programmatic workflows"],"title":"Semantic AI Search"},"stock_music":{"items":["Access royalty-free tracks in high-quality formats","Filter by genre, mood, and instrumentation","Commercial-ready licensing"],"title":"Original Stock Music"},"stock_video":{"items":["Search and retrieve curated HD & 4K footage","Commercial-safe licensing for product use","Structured metadata for reliable filtering"],"title":"Original Stock Video"}},"documentation":"View Documentation"},"auth":{"password_reset":{"title":"Reset password","cancel":"Back to Login","errors":{"passwords_not_matched":"Passwords doesn’t match"},"submit":"Reset password","description":"Create a new password.","new_password":"New Password","repeat_password":"Confirm password","new_password_placeholder":"Create a new password","repeat_password_place