Something went wrong. Please try again.","upgrade_modal":{"title":"Upgrade plan","subtitle":"You are about to change your subscription plan. Please review the details below.","amount_due":"Amount due today","terms_html":"By clicking \"Confirm\", you agree to our \u003Ca href=\"/terms\" target=\"_blank\">Terms of Service\u003C/a>. Your new plan will start immediately.","confirm_btn":"Confirm and Pay","new_plan_label":"New plan","unused_credits":"Unused credits","prorations_label":"Prorations","current_plan_label":"Current plan"},"downgrade_modal":{"title":"Downgrade plan","terms_html":"By clicking \"Confirm\", you agree to our \u003Ca href=\"/terms\" target=\"_blank\">Terms of Service\u003C/a>. Your new plan will start at the next billing cycle."},"downgrade_applied_next_billing_period":"Your new plan will start at the next billing cycle"},"attribution_required_block":{"title":"Upgrade to avoid attribution","paragraph_1":"You can use this clip in unlimited projects, but you must credit the author. \u003Ca href=\"https://coverr.co/license/\" target=\"_blank\" class=\"acu-link\">View license\u003C/a>.","paragraph_2":"To avoid attribution, upgrade to Coverr+"},"explore_shutterstock_modal":{"title":"Can’t find an videos you’re interested in?","description":"Try our partner, Shutterstock"},"request_password_reset_page":{"meta":{"title":"Request password reset | Coverr","description":"Send request to reset your password"}},"ai_generated_category_banner":{"text":"\u003Cp class=\"highlight-banner__text text-xl\">The \u003Cspan class=\"highlight-banner__gradient-text\">most advanced\u003C/span> AI Video model is now on \u003Cspan class=\"highlight-banner__gradient-text\">Coverr+\u003C/span>\u003C/p>","cta_copy":"Try Veo 3"},"ai_video_generator_landing_page":{"faq":[{"answer":"Creating an AI video is easy! Just choose whether you want to use text or an image, type your prompt, and click \"Generate.\" Our AI will turn your idea into a video in seconds.","question":"How to create the AI video?"},{"answer":"To get the best video results, type a clear and detailed prompt. If you’re unsure, use our built-in prompt enhancer tool to help refine your text or image for better video quality.","question":"How to prompt AI video generator?"},{"answer":"The text-to-video generator turns your written ideas into videos, while the image-to-video generator takes an image and adds movement. Both tools create videos, but the process is different. You can use the prompt enhancer with both features to improve the results and get the best video possible.","question":"What is the difference between text to video or image to video generator?"},{"answer":"You get 10 credits each month to create videos for free. If you need more, you can easily buy additional credits to keep making videos as needed.","question":"How many videos can I create?"}],"hero":{"title":"AI Video Generator","description":"Transform text or images into dynamic videos with ease. Use our built-in prompt enhancer for better results, all in one simple tool."},"uses":{"title":"How you can use AI videos","features":[{"icon":"shoppingBag","title":"AI video for business","description":"Create professional videos to promote your business, explain services, or share updates with your team"},{"icon":"broadcast","title":"AI video for advertisement & marketing","description":"Easily make eye-catching ads that grab attention and boost your brand with minimal effort"},{"icon":"userHeart","title":"AI video for social media","description":"Create fun, engaging videos to share on social media and connect with your audience"},{"icon":"hammer","title":"AI video for products","description":"Showcase your products in action, highlight features, and make them stand out with engaging videos"}],"description":"Create professional videos for any purpose: whether it’s showing products, promoting your brand, or connecting with your audience on social media."},"videos":{"features":[{"title":"Text to Video AI generator","description":"Write a prompt, and watch your words transform into a dynamic video"},{"title":"Image to Video AI generator","description":"Start with an image, and bring it to life with smooth motion"},{"title":"Enhance prompt with simple tool","description":"Get better results with a built-in assistant to refine your prompts"}]},"ai_input":{"title":"Create Your First Video Now","description":"Turn your ideas into videos in seconds. Click below to get started!"},"features":{"data":[{"image":"/assets/images/ai-video-generator-landing/features.jpeg","title":"Generate video from text","description":"Turn your written ideas into engaging videos. Simply type your text, and our AI will create a video based on your words","action_label":"Generate video from text","event_action":"ai_video_gen_landing_cta_feature_text"},{"title":"Generate video from images","description":"Bring your images to life. Upload an image, and our AI will turn it into a moving video","action_label":"Generate video from image","event_action":"ai_video_gen_landing_cta_feature_image"},{"title":"AI video prompt generator","description":"Need help with your video idea? Use our prompt generator to refine your text or image prompts for better results","action_label":"Use prompt enhancer"}],"title":"Powerful AI Video Features for Every Need","description":"Create videos in seconds, whether you’re starting from text, images, or need help crafting the perfect prompt"}}}},"h":{},"s":200,"st":"OK","u":"https://public-api.coverr.co/app-localizations/en","rt":"json"},"1818764200":{"b":{"hits":[{"id":"WSv17AxDb9","createdAt":"2021-08-20T12:09:47.602Z","updatedAt":"2024-12-16T09:44:57.752Z","name":"Nature","slug":"nature","title":"Free Nature Stock Video Footage","metaTitle":"Free Nature Stock Video Footage: Download Nature Clips for Free","description":"Bring the outdoors in with videos that invite a sense of wonder, calm, and exploration to any website or project. Follow birds swooping through the coast, campers enjoying #tentlife, or enjoy a stroll through the forest, plus many more from our collection of nature videos.","metaDescription":"Download free nature videos for use on your website or any project (personal or commercial). Access a wide range of free nature clips in 4K and HD.","icon":"https://storage.googleapis.com/coverr-public/tags/nature.svg","bgVideoId":"RBiFBazZ2K","isVertical":false,"hidden":false,"urlPath":"Nature","order":0,"coverVideo":"RBiFBazZ2K","coverImage":"https://cdn.coverr.co/videos/coverr-desert-island-7521/thumbnail?width=640","tags":["nature","sky","beach","flower","rain","sun","snow","forest","sea","windy","ocean"],"filters":null,"sstkQuery":null,"seoText":"\u003Ch2>Explore Our Collection of Nature Stock Videos\n\u003C/h2> \n\u003Cp>Browse through our expansive library of free Nature stock videos, featuring a diverse selection of scenes that can fit various project needs. Our collection offers something for every type of production. Whether you're creating an ad, designing content for social media, or developing educational material, our Nature videos provide the flexibility you need.\u003C/p>\n\u003Cp>Each clip is designed to deliver captivating visuals that will enhance your storytelling and bring your ideas to life. With our constantly expanding library, you’ll find fresh, high-quality content for all your video projects.\u003C/p>\n\u003Ch2>High-Quality Nature Footage in 4K and HD\u003C/h2>\n\u003Cp>All of our Nature stock footage is available in stunning 4K and HD resolutions, ensuring your content is crisp and high-quality no matter the platform. Whether you're crafting a cinematic production or a professional corporate video, our footage provides the clarity and detail needed to captivate your audience.\u003C/p>\n\u003Cp>The ultra-high definition of our 4K Nature videos brings out the fine details, while the HD options are perfect for web-based content and social media posts. No matter the resolution you choose, each clip is optimized to maintain the best visual quality and deliver maximum impact for your projects.\u003C/p>\n\u003Ch2>Simple Steps to Download and Use Our Nature Videos\u003C/h2>\n\u003Cp>Downloading and using our free Nature stock videos is incredibly simple. First, browse our carefully organized library of clips and choose the perfect one for your project. Once you've found the ideal footage, you can download it in just a few clicks. There are no sign-up fees, and the process is completely free, giving you access to high-quality Nature videos that are ready to use in your creative work.\u003C/p>\n\u003Cp>Our intuitive website allows you to easily search, preview, and select videos based on your needs, so you can get started immediately. Whether it's for a marketing campaign, a YouTube video, or any other project, our straightforward download process ensures you can start editing right away.\u003C/p>","bannerConfig":{},"meta":{"title":"Free Nature Stock Video Footage: Download Nature Clips for Free","description":"Download free nature videos for use on your website or any project (personal or commercial). Access a wide range of free nature clips in 4K and HD."},"subcategories":[{"id":"3NiOjZoPoqTn","createdAt":"2021-09-28T00:01:02.013Z","updatedAt":"2024-12-02T19:07:48.538Z","name":"forest","videosCount":1191,"slug":"forest","title":"Free Forest Stock Video Footage","metaTitle":"Free Forest Stock Video Footage & Clips Download: HD & 4K Videos","description":"Explore and download over  beautiful forest stock video clips and footage for your website or any project. Download high-quality royalty-free forest videos in HD and 4K for free.","metaDescription":"Free forest stock video footage & clips in HD and 4K are perfect for enhancing your creative endeavors. Experience the tranquility of lush forests with breathtaking footage.","redirect":null,"sstkQuery":null,"categoryId":"WSv17AxDb9","filters":null,"bannerConfig":{}},{"id":"PWeFhXCk8ut7","createdAt":"2021-09-28T00:01:21.449Z","updated