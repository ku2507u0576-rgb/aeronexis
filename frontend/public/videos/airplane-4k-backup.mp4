tle":"Collections | Coverr","description":"Explore curated collections handpicked by our staff"},"title":"Collections","one_item":"item","description":"Explore curated collections handpicked by our staff","plural_of_items":"items"},"contribute_modal":{"title":"Contribute to Coverr","toasts":{"video_submitted":{"title":"Video Submitted! Thank You!","description":"We’ll review your video and publish it on our website."}},"license":"All published videos are licensed under the \u003Ca href=\"https://coverr.co/license/\" target=\"_blank\" class=\"acu-link\">Coverr license\u003C/a> and are free to use. Videos will appear in both the video library and AI workflows.","subtitle":"Thank you for helping us make content accessible to everyone!","features_list":{"title":"What you’ll get:","features":["Become a verified contributor","Receive the attention of our audience","Credit as the author of your content","Personalized author page on our platform"]}},"download_history":{"meta":{"title":"Download History | Coverr","description":"Download History"}},"free_stock_music":{"faq":[{"answer":"\u003Cp>Royalty-free music is a type of music licensing that allows individuals and businesses to use music without having to pay ongoing royalties or fees for each use.\u003C/p>\u003Cp class=\"mt-3\">Coverr offer you to download free stock music with no tricks and extra fees.\u003C/p>","question":"What is royalty-free music?"},{"answer":"We’re now in the hunt for the best composers out there, we’re paying for all the free music we’re going to offer so if you’re interested, please apply \u003Ca href=\"/developers\" aria-label=\"Developers page\" class=\"acu-link\">here\u003C/a>.","question":"I’m a musician/composer, how can I get involved?"},{"answer":"Since WAV format is the highest quality, and quality is what we believe in, you’ll get our free songs in: WAV 16 bit, 44.1 kHz MP3 320 kbit/s","question":"What is the quality of the songs available to download?"},{"answer":"\u003Cp>Coverr Free Music is ideal to be used as free background music for all types of videos. Other popular use cases where you can use our free music tracks include:\u003C/p>\u003Cul>\u003Cli>YouTube\u003C/li>\u003Cli>Blogs\u003C/li>\u003Cli>Music Videos\u003C/li>\u003Cli>Websites\u003C/li>\u003Cli>Social Media platforms\u003C/li>\u003Cli>Podcasts\u003C/li>\u003Cli>Online ads\u003C/li>\u003Cli>Video Games\u003C/li>\u003C/ul>","question":"Where can I use Coverr’s Free Stock Music?"},{"answer":"Yes, it’s fine to use our stock music tracks and videos on YouTube.","question":"Can I use Coverr Free Music on YouTube?"},{"answer":"That’s because we have an affiliate partnership in which we show our users additional options in case we weren’t able to satisfy our users’ needs.","question":"Why am I seeing music tracks from ShutterStock/PremiumBeat?"},{"answer":"Attribution is appreciated but not required. We’d love to see what you create using our free music and videos, so feel free to mention @coverrco and/or link to coverr.co if you feel like it.","question":"Am I supposed to attribute Coverr if I’m using your free stock music?"},{"answer":"Wow, we love great ideas! Please \u003Ca href=\"/contact-us\" class=\"acu-link\">contact us\u003C/a>.","question":"What if I have a great idea for you guys?"}],"mood":"Mood","genres":"Genres","breadcrumb":"Free Stock Music","top_tracks":"Top tracks","instruments":"Instruments","popular_tags":{"synth":"synth","dreamy":"dreamy","ambient":"ambient","cinematic":"cinematic","electronic":"electronic"}},"get_more_credits":{"title":"Get more AI credits","toast":{"title":"Need more?","description":"Contact us to get more credits"},"description":"Buy more credits and explore your creativity","pricing_toast":{"cta":"View pricing","title":"How much can I generate?","description":"Check detailed plans and costs on our Pricing page"},"pricing_details":{"li_1":"Ai Voice Over - 1 character = 1 credit (1 minute script = ~625 credits)","li_2":"Ai Video - 1 video = 5K credits","li_3":"Ai Sound Effect - 1 sound effect = 200 credits","title":"Pricing details"}},"highlight_banner":{"text":"\u003Cp class=\"highlight-banner__text text-xl\">The \u003Cspan class=\"highlight-banner__gradient-text\">most advanced\u003C/span> AI Video model is now on \u003Cspan class=\"highlight-banner__gradient-text\">Coverr+\u003C/span>\u003C/p>","button_text":"Generate videos with Veo 2","default_alt":"Thumbnail of an AI-generated video created using Google Veo 2"},"marketing_studio":{"grid_title":"Get Inspired","video_titles":{"tvc":"TV Spot","ugc":"UGC","try_on":"Virtual Try-On","tutorial":"Tutorial","unboxing":"Unboxing","wild_card":"Wild Card","camera_pov":"Camera POV","pro_try_on":"Pro Try-On","secret_hack":"Secret Hack","before_after":"Before & After","giant_figure":"Giant Figure","hyper_motion":"Hyper Motion","unboxing_asmr":"Unboxing ASMR","gadget_saved_me":"Gadget Saved Me","try_on_sneakers":"Sneaker Try-On","unboxing_try_on":"Unboxing Try-On","direct_to_camera":"Direct to Camera","selfie_testimonial":"Selfie Testimonial"},"use_cases_title":"Popular Use Cases","grid_description":"Discover high-quality videos — for creators","styles_modal_title":"Choose a style"},"new_project_page":{"creative":"Creative","marketing":"Marketing"},"plus_hero_widget":{"cta":"Upgrade","title":"Unlock More with Coverr","benefit_1":"AI video creation","benefit_2":"Members-only premium content","benefit_3":"4K Footage & WAV Music","benefit_4":"Ad-free experience","benefit_5":"Support our Filmmakers","benefit_6":"AI Smart Crop","cta_for_plus":"Explore Catalog","title_for_plus":"Coverr+ Unlocked"},"user_collections":{"back":"Back","meta":{"title":"My Collections | Coverr","description":"My Collections"},"name":"Name","title":"Title","errors":{"error_load":"Ooops, error happened while loading a collection. Please try again.","error_create":"Ooops, error happened while creating a collection. Please try again.","error_delete":"Ooops, error happened while deleting a collection. Please try again.","error_update":"Ooops, error happened updating creating a collection. Please try again.","name_required":"Name field is required","title_required":"Title field is required","description_required":"Description field is required"},"add_video":"Add video","delete_yes":"Yes, I would like to delete.","delete_body":"The deletion is permanent. Once a collection is deleted, it cannot be recovered.","description":"Description","delete_title":"Are you sure you want to delete the collection?","start_adding":"Add videos to the collection","new_collection":"New collection","no_collections":"No collections yet","start_exploring":"Start exploring","update_collection":"Update collection","create_new_collection":"Create new collection"},"value_prop_modal":{"title":"Make it yours \u003Cspan class=\"color-new-primary-main\">with AI\u003C/span>","footer":"Ready for more? Check details on","description":"Thanks for downloading — that clip’s yours. Sign up free to save the next one, and the next thousand.","primary_cta_copy":"Sign up free","propositions_section_label":"What you’ll get with a free account:"},"ai_models_section":{"cta":"Try now","title":"Turn your ideas into beautiful AI creations today","description":"Craft new AI visuals or rework any asset from our full stock library — limitless creative possibilities"},"ai_voices_filters":{"age":"Age","accent":"Accent","gender":"Gender","use_case":"Use case"},"cancellation_flow":{"form":{"title":"We are sorry to see you go.","buttons":{"stay":"Stay with Coverr+","cancel":"Cancel Subscription"},"reasons":["I only needed one video","Not enough premium videos available","AI generator quality isn’t good enough","I found a better alternative","I’m not using the service enough","The subscription is too expensive"],"request":"Can you share more about your reason? \u003Cspan class=\"wa-cancel-modal-last__secondary\">(optional)\u003C/span>","description":"Could you please tell us what led you to cancel your subscription?","cancel_reason":"Please, select a reason for canceling"},"hint":"\u003Csup>*\u003C/sup> Your subscription and AI credits stay active until the end of the billing period. You can still access your old AI generated content","title":"Cancel \u003Cspan class=\"color-gradient-blue\">Coverr+\u003C/span> \u003Cbr /> subscription?","values":[{"link":"/studio","text_1":"Full ","text_2":"access and monthly AI credits","ga_event":"cancellation_flow_retention_ai_studio_link","link_label":"AI studio "},{"link":"/stock-video-footage","link_2":"/free-stock-music","text_2":"&","text_3":"for comercial projects","ga_event":"cancellation_flow_retention_4K_footage_link","ga_event_2":"cancellation_flow_retention_wav_music_link","link_label":"4K footage","link_label_2":"WAV music"},{"link":"/stock-video-footage/plus","text_2":"added weekly","ga_event":"cancellation_flow_retention_exclusive_content_link","link_label":"Exclusive content"},{"link":"/profile/edit","text_2":"experience","ga_event":"cancellation_flow_retention_ad_free_link","link_label":"Ad-free"}],"buttons":{"stay":"Stay with Coverr+","cancel":"Cancel Subscription"},"discount":{"title":"One last thing","accept_button":"I’ll take it","cancel_button":"Cancel Subscription","error_message":"There was an error activating your discount. Please try again.","success_message":"Thanks for staying — your subscription will include your discount starting with the next billing period.","description_year":"How about 20% off your yearly renewal as a thank-you for staying with us?","description_month":"How about 50% off your subscription for the next 3 months?"},"feedback":{"text":"Coverr+ is the ultimate creative hub —premium-quality videos, images, and music, combined with powerful AI tools to generate fresh content.","author":"Anna Patel, Social Media Manager"},"description":"You’re about to lose access to your premium AI and creative benefits:"},"contribute_banner":{"title":"Contribute and get discovered","subtitle":"Are you an AI video enthusiast? We would love to feature your work.","benefit_1":"Get more followers","benefit_2":"Inspire others and get inspired","benefit_3":"Join our exclusive community"},"exit_intent_modal":{"title":"Here’s how Coverr stays free","eyebrow":"Before you go","description":"Coverr’s free library is supported by our partner iStock and by our Plus subscribers. Pick whichever suits you — no pressure.","dismiss_copy":"Keep browsing","plus_cta_copy":"Go Plus — ad-free, 4K, full library","istock_promo_cta_copy":"Use iStock with -{{discount}} (code \"{{code}}\")","istock_library_cta_copy":"Browse iStock’s full library"},"help_and_feedback":{"email":{"errors":{"regex":"Please enter a valid email address","required":"Email is required"},"placeholder":"example@example.com"},"toast":{"error":"There was an error sending feedback.","success":"Your feedback has been sent successfully!"},"message":{"errors":{"required":"Message is required"},"placeholder":"Add feedback here..."}},"projects_selector":{"title":"Select a project","delete_modal":{"body":"All creations in this project will be permanently deleted.","title":"Delete this project?","confirm_copy":"Delete project"},"search_placeholder":"Search projects","default_project_name":"Default project","new_project_cta_copy":"New project","create_project_success":"Project created successfully","project_name_placeholder":"Project name"},"subscription_page":{"faq":[{"answer":"Coverr Plus is our premium subscription plan offering members exclusive access to high-quality stock footage, ad-free browsing, 4K video resolution, high-quality WAV format music, and other exciting features and enhancements.","question":"What is Coverr Plus?"},{"answer":"Our team curates and adds fresh, exclusive content to Coverr Plus every week, providing members with a constantly growing library of captivating footage and music tracks for their projects.","question":"How often does Coverr Plus add new content?"},{"answer":"With a Coverr Plus subscription, you can enjoy browsing our platform without any ads or sponsored content, allowing you to concentrate on selecting the perfect footage and music for your creative projects. If you prefer to leave these sponsored content recommendations, you can turn it on.","question":"What does the ad-free experience entail?"},{"answer":"No, access to 4K video resolution and high-quality WAV format music is exclusively available to our Coverr Plus members.","question":"Is 4K footage and WAV music available for free users?"},{"answer":"Simply click on \"Get Coverr+\" or \"See Pricing\" to view our subscription plans, choose the one that best suits your needs, and follow the steps to upgrade your account.","question":"How do I upgrade to Coverr Plus?"},{"answer":"Yes, you can cancel your subscription at any time. Once canceled, your subscription will remain active until the end of your current billing cycle.","question":"Can I cancel my Coverr Plus subscription anytime?"},{"answer":"Coverr Plus content can be used for both personal and commercial projects. For more information on usage rights and restrictions, please refer to our terms of service and licensing agreements.","question":"What are the usage rights and restrictions for Coverr Plus content?"},{"answer":"No, Coverr Plus subscriptions are for single-user licenses only. Only the account owner has the right to use the content. A company can have an account, but it remains a single seat-license, meaning only one person can download and select content/use the content at a time, and it cannot be stored on a DAM for broad sharing rights.","question":"Can I share my Coverr Plus subscription with someone else?"},{"answer":"Yes, your Coverr Plus subscription will automatically renew at the end of each billing period. This ensures uninterrupted access to the features and content provided by Coverr Plus. However, you have the flexibility to cancel your subscription at any time before the renewal date.","question":"Does my subscription automatically renew?"},{"answer":"We offer various payment methods to make it convenient for you to subscribe to Coverr Plus. Currently, we accept major credit cards and PayPal.","question":"What payment methods do you offer?"}],"meta":{"title":"Buy 4K Videos for Commercial Use: Pay for Ultra HD Video","description":"Buy 4K & Ultra HD Videos and WAV Music for Commercial Use ✅ Unlock premium stock footage, ad-free browsing, and high-quality formats."}},"user_upload_modal":{"select":{"or":"or","title":"Upload new Video","size_hint":"Minimum 640px width recommended. Max 80 MB each.","select_file":"Select File","create_scene":"Create Scene","drag_drop_hint":"You can Drag & Drop files and folders onto this page","guideline_format":"High resolution Videos (.MP4, .MOV)","guideline_rights":"Only upload media you own the rights to"},"upload":{"title":"Upload new Video","toast":{"error":{"title":"An error occurred while uploading files","description":"Here are the files that have not been uploaded"},"success":{"title":"Uploading Successfully Started","description":"Please wait until the upload is complete and don’t close this window"}},"add_scene":"Add Scene","add_videos":"Add videos","select_file":"Select file","remove_scene":"Remove Scene","videos_title":"Videos","save_and_upload":"Save & Upload","license_agreement":"By uploading videos you agree that these videos will fully belong to Coverr"},"success":{"close":"Close Modal","title":"All videos have been successfully uploaded!","upload_more":"Upload More"}},"ai_gen_card_shared":{"error":{"refund":"AI Credits Refund","refund_HTML":"Credits for this failed generation will be refunded automatically within minutes. You can view it in your \u003Ca href=\"{{creditHistoryUrl}}\" class=\"acu-link\">AI Credit History\u003C/a>"},"loader":{"refund":"Credits will be refunded if the generation fails"}},"ai_video_workflows":{"toasts":{"prompt_copied":"Prompt was copied to clipboard!"},"tools_used":"TOOLS USED:","ai_workflow":"AI Workflow:","promp