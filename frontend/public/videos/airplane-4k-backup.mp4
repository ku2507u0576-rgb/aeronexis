sed all your free credits. Upgrade to keep creating.","from_credits_param":"{{ count }}+ credits","signup_description":"Sign up to generate for free","generations_available":"Generations available: {{ count }}","all_models_description":"Pick any from {{ count }} available","auto_model_description":"We’ll pick the best model for your prompt","free_generations_param":"{{ model }} free generations: {{ count }} left","rate_limit_description":"You’ve reached your parallel generation limit. Wait for current generations to finish or upgrade to continue without waiting","support_only_one_option":"This model supports only a single option"},"videos":{"title":"AI Video Generator","styles":"Styles","effects":"Effects","description":"Use the Image to Video or Text to Video AI generator","inspiration":"Inspiration","explore_more":"Explore more","recreate_tour":{"done_cta":"Let’s recreate!","textarea":{"title":"Add your details","description":"Describe how you’d like to reimagine your video — lighting, camera movement, or visual style. Then hit Generate to bring it to life."},"media_uploader":{"title":"Select a Video","description":"Choose a video from our stock library that you’d like to reimagine."},"app_prefference":{"title":"Select an App","description":"Choose what you want to do — for example New camera angles or Generate next shot."},"preset_prefference":{"title":"Select a Preset","description":"Pick a visual style to define your recreated video."},"mode_segment_controls":{"title":"Recreate is here","description":"Transform your existing videos — change camera angles, style, or even generate the next shot to continue your story."}},"generation_rate":"Generation cost: {{ cost }} credits","how_it_works_page":{"steps":{"generate":{"title":"Generate Video","description":"Click generate and watch AI create your video in minutes"},"configure":{"title":"Configure Settings","description":"Adjust duration, aspect ratio, resolution, and other parameters to customize your video"},"edi